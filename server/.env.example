# Copia este ficheiro para .env e preenche com os teus valores.
# O .env nunca vai para o git.

NODE_ENV=development
PORT=3000

# Ligação ao PostgreSQL: postgresql://UTILIZADOR:PASSWORD@HOST:PORTA/BASE_DE_DADOS
DATABASE_URL="postgresql://utilizador:password@localhost:5432/fe_match?schema=public"

# Password usada por TODOS os utilizadores fictícios do seed (só para testes locais).
SEED_USER_PASSWORD=escolhe-uma-password-de-teste
